# ==========================================
# Autonomous AI Task Worker Configuration
# ==========================================

# AcmeOps Local ERP Server
ACME_HOST=127.0.0.1
ACME_PORT=8000
ACME_BASE_URL=http://127.0.0.1:8000
ACME_ADMIN_USERNAME=admin
ACME_ADMIN_PASSWORD=acmepass123

# LLM Reasoning Engine
# Provider: 'auto', 'openai', 'gemini', or 'deterministic'
# If no API key is provided, the built-in DeterministicPlannerEngine runs out of the box.
LLM_PROVIDER=auto

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Browser Automation (Playwright)
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=200

# Agent Budget Limits
MAX_STEPS=25
MAX_RETRIES_PER_FAILURE=3
